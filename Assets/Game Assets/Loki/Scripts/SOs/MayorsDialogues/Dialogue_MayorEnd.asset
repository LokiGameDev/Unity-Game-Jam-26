  m_Script: {fileID: 11500000, guid: 275091b99b7eacd40a40ec48225b80b7, type: 3}
  m_Name: Dialogue_MayorEnd
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 302
  lines:
  - speakerName: Mayor
    portrait: {fileID: 424516655, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Oh Wow! You fixed the clock tower? How?
  - speakerName: Mayor
    portrait: {fileID: 424516655, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: However it is we are grateful for it!
  - speakerName: Mayor
    portrait: {fileID: 424516655, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: You can visit us whenever you want and you dont need to pay
  - speakerName: Mayor
    portrait: {fileID: 424516655, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: We really thank you from bottom of our hearts
  - speakerName: Mayor
    portrait: {fileID: 424516655, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Thank you, Visitor
