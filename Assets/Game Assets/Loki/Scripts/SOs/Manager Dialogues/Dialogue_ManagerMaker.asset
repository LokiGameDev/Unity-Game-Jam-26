  m_Script: {fileID: 11500000, guid: 275091b99b7eacd40a40ec48225b80b7, type: 3}
  m_Name: Dialogue_ManagerMaker
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 100
  lines:
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Thats it! Now you have your own lucky number.
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: I have allocated a room for you in the first floor
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: You can rest there and see around the town
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: And if you have free time visit the town's Mayor and Clock maker
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: They are also staying in the first floor of this hotel
