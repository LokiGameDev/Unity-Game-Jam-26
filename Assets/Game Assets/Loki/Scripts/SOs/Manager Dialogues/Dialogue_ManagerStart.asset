  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 275091b99b7eacd40a40ec48225b80b7, type: 3}
  m_Name: Dialogue_ManagerStart
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 101
  lines:
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Welcome Traveller. You look tired, I will book a room for you.
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: ' Let me check your Lucky Number first.'
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Wait you dont have a lucky number.
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: In this town you need a lucky number for everything
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Because we believe that the lucky number will guide us.
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: You can choose your lucky number from the machine at the right end of this
      hotel.
  - speakerName: Manager
    portrait: {fileID: -845711139, guid: ec375931c4f9874488351aac5b5cbf1c, type: 3}
    text: Go and try it. And then comeback.
